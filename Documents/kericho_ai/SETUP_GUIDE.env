# WhatsApp Healthcare Assistant - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============ Server Configuration ============
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# ============ Database - PostgreSQL ============
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public

# Local PostgreSQL (Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kericho_ai?schema=public

# OR managed PostgreSQL (Neon, Supabase, Railway, etc.)
# DATABASE_URL=postgresql://user:password@host.neon.tech:5432/neondb?schema=public

# ============ WhatsApp Cloud API (Meta) ============
# Get these from: https://developers.facebook.com/apps/
# Dashboard → Your App → WhatsApp → API Setup

# Mode: either "meta" (webhook) or "baileys" (local dev, requires QR scan)
WHATSAPP_PROVIDER=meta

# Token you set up in Meta dashboard for webhook verification
# This is what Meta calls "Verify Token"
# Set it to something secure, e.g.: "kericho_healthcare_2024_secret_token_12345"
WHATSAPP_VERIFY_TOKEN=your-secure-verify-token-here

# Meta's access token for sending messages
# Get from: App Dashboard → WhatsApp → API Setup → Temporary Access Token
# Or generate a permanent one from System User
WHATSAPP_ACCESS_TOKEN=your-meta-access-token-here

# Your WhatsApp Business Phone Number ID
# Get from: App Dashboard → WhatsApp → API Setup → Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-here

# Meta Graph API version (usually latest, e.g., v20.0)
WHATSAPP_API_VERSION=v20.0

# ============ OpenAI API ============
# Get from: https://platform.openai.com/api-keys

# Your OpenAI API key (starts with sk-)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model to use (gpt-3.5-turbo is faster/cheaper, gpt-4 is smarter)
OPENAI_MODEL=gpt-3.5-turbo

# ============ Application Settings ============
DEFAULT_LANGUAGE=en
EMERGENCY_CONTACT_TEXT=🚨 This may be a medical emergency. Go to hospital immediately or call 112. Visit the nearest health facility in Kericho County now.

# ============ Logging ============
LOG_LEVEL=info

# ============ Security ============
# Add any rate limiting, auth keys, etc. here
# RATE_LIMIT_REQUESTS_PER_MINUTE=10
# API_KEY_SECRET=your-secret-here


# ============ SETUP INSTRUCTIONS ============
#
# 1. WHATSAPP CLOUD API SETUP:
#
#    a) Create Meta Business Account
#       - Go to: https://business.facebook.com
#       - Create new business
#
#    b) Create an App
#       - Go to: https://developers.facebook.com/apps
#       - Create App → Business/Marketing → WhatsApp
#
#    c) Set Up WhatsApp
#       - In App Dashboard: WhatsApp → Getting Started
#       - Click "Create Business Phone Number" or use existing
#       - Get Phone Number ID → paste into WHATSAPP_PHONE_NUMBER_ID
#
#    d) Set Up Webhook
#       - WhatsApp Setup → Configuration → Webhooks
#       - Callback URL: https://your-app.com/webhook
#       - Verify Token: Set a random secure string
#       - Paste both into WHATSAPP_VERIFY_TOKEN
#       - Subscribe to "messages" webhook field
#
#    e) Get Access Token
#       - App Dashboard → Settings → Access Tokens
#       - Generate or get Temporary Access Token
#       - Paste into WHATSAPP_ACCESS_TOKEN
#
# 2. OPENAI API SETUP:
#
#    a) Go to https://platform.openai.com
#    b) Sign up or log in
#    c) Go to: Account → API keys
#    d) Create new secret key
#    e) Paste into OPENAI_API_KEY
#
# 3. POSTGRESQL SETUP:
#
#    a) Local setup:
#       docker-compose up -d postgres
#
#    b) Or use managed service:
#       - Neon: https://neon.tech (Free)
#       - Supabase: https://supabase.com (Free)
#       - Railway: https://railway.app
#       - Render: https://render.com
#
#    c) Get connection string and paste into DATABASE_URL
#
# 4. START SERVER:
#
#    npm install
#    npm run prisma:migrate
#    npm run prisma:seed
#    npm start
#
# ============ END SETUP INSTRUCTIONS ============
