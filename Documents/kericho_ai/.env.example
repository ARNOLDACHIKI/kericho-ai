NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# PostgreSQL Configuration
# Local: postgresql://postgres:postgres@localhost:5432/kericho_ai?schema=public
# Managed Postgres: postgresql://user:password@host:5432/kericho_ai?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kericho_ai?schema=public

# WhatsApp Gateway Configuration
# baileys = local development using WhatsApp Web QR
# meta = WhatsApp Cloud API webhook mode
WHATSAPP_PROVIDER=baileys
VERIFY_TOKEN=kericho-verify-token
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# Backward-compatible names still supported:
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# OpenAI Configuration (Optional - for AI responses)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# Google Maps Configuration (Optional - for nearby hospital directions)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# JWT Configuration (Admin authentication)
JWT_SECRET=change-this-to-a-strong-random-secret

# Language Configuration
DEFAULT_LANGUAGE=en

# Emergency Contact Information
EMERGENCY_CONTACT_TEXT=🚨 This may be a medical emergency. Call 999 or visit the nearest health facility in Kericho County immediately.

